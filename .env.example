# Token que te da @BotFather en Telegram
TELEGRAM_TOKEN=tu_token_de_botfather

# Lunes de referencia (AAAA-MM-DD, debe ser lunes). Solo lo usa la rotación de algún plato
PLAN_START=2026-10-05

# Aviso diario
REMINDER_HOUR=8
REMINDER_MINUTE=30
TIMEZONE=Europe/Madrid

DB_PATH=entrenos.db

# Segundos/km que se suman a tu marca de media (4:38) hasta que hagas el primer test
DESENTRENO_SEC=15

# --- Dieta y compra en Mercadona ---
# Almacén de Mercadona de tu zona (CP 18002 -> 2183)
MERCADONA_WH=2183
PRESUPUESTO_SEMANAL=55
# Volumen muy limpio: +150 kcal/día ≈ +0,1 kg/semana. Al llegar a PESO_OBJETIVO, mantenimiento
SUPERAVIT_KCAL=150
OBJETIVO_KG_SEMANA=0.1
PESO_OBJETIVO=81
# La lista de la compra se envía los sábados a esta hora
COMPRA_HOUR=8
COMPRA_MINUTE=30
# Suplementos de HSN (gramos al día; 0 si no los tomas)
WHEY_GRAMOS=30
CREATINA_GRAMOS=5
ALIMENTOS_EXCLUIDOS=brócoli,col,coles,repollo,lombarda,coles de bruselas,coliflor

# --- Coach conversacional con Claude (opcional) ---
# API key de https://console.anthropic.com (pago por uso, NO va incluida en Claude Pro).
# Sin key, el texto libre no funciona pero /carrera, /bici y /sensaciones sí (con reglas fijas).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_MENSAJES_DIA=40

# --- Notion (opcional) ---
# 1. Crea una integración en https://www.notion.so/my-integrations y copia el "Internal Integration Secret"
# 2. Crea una página en Notion y compártela con la integración (menú ••• > Conexiones)
# 3. El ID de la página son los 32 caracteres finales de su URL
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# --- Garmin (opcional) ---
# 1. Ejecuta una vez: .venv/bin/python garmin_login.py  (guarda los tokens, no la contraseña)
# 2. Pon aquí tu chat de Telegram (/garmin te lo dice). 0 = desactivado
GARMIN_CHAT_ID=0
GARMIN_TOKENS_DIR=~/.garminconnect
# Solo si no usas garmin_login.py (no vale con MFA)
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_SYNC_MIN=15
# Usar la predicción de media del reloj para los ritmos si el último test tiene más de TEST_VIGENCIA_DIAS días
GARMIN_USAR_PREDICCION=1
TEST_VIGENCIA_DIAS=70

# FC de umbral de lactato corriendo (ppm) para las zonas de /bici. 0 = la que mide el reloj
FC_UMBRAL=0
